{
  "name": "@opengym/cloudflare-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm run test",
    "test:integration": "node test/local-worker.mjs",
    "build:staging": "wrangler deploy --config wrangler.staging.jsonc --dry-run --outdir dist-staging",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "cbor-x": "^1.6.9",
    "wrangler": "^4.100.0"
  }
}
