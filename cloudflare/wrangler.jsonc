{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opengym-cloudflare",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountDO" },
      { "name": "PROFILES", "class_name": "ProfileDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountDO", "ProfileDO"] }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "opengym-media" }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": { "ALLOW_GUEST": "true", "FIRST_USER_ADMIN": "false" }
}
